nextflow_pipeline {
    name "Tomato smoke workflow (mm2plus)"
    script "main.nf"

    // Kept in a separate file so hosts without mm2plus can still run
    // tests/tomato_smoke.nf.test without pulling bioconda::mm2plus.
    test("runs tomato fixture end to end with mm2plus") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                aligner = "mm2plus"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            // chain files are not byte-comparable across aligners (ids/order differ);
            // coordinate-level liftover outputs are the real equivalence check.
            assert path("$outputDir/chain/all.chain").exists()
            assert path("$outputDir/chain/all.chain").size() > 0
            assert path("$outputDir/liftover/tomato-smoke.id").text == "chr01_1000\nchr01_5000\nchr01_9000\n"
            assert path("$outputDir/liftover/tomato-smoke.bed").text == "chr01\t999\t1000\nchr01\t4999\t5000\nchr01\t8999\t9000\n"
            assert path("$outputDir/liftover/tomato-smoke.snpcalling.bed").text == "chr01\t899\t1100\nchr01\t4899\t5100\nchr01\t8899\t9100\n"
        }
    }
}
