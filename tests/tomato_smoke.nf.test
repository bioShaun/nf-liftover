nextflow_pipeline {
    name "Tomato smoke workflow"
    script "main.nf"

    test("runs tomato fixture end to end") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert path("$outputDir/chain/all.chain").exists()
            assert path("$outputDir/chain/chain_meta.yml").exists()
            assert path("$outputDir/software_versions.yml").exists()
            // Legacy config has no aligner param; base.config must fall back to minimap2.
            assert path("$outputDir/software_versions.yml").text.contains("minimap2")
            assert path("$outputDir/run_meta.yml").exists()
            assert !path("$outputDir/chain/all.paf").exists()
            assert !path("$outputDir/software_versions.yml").text.contains("END\n")
            assert path("$outputDir/chain/chain_meta.yml").text.contains("chain_headers_checked")
            assert path("$outputDir/liftover/tomato-smoke.id").text == "chr01_1000\nchr01_5000\nchr01_9000\n"
            assert path("$outputDir/liftover/tomato-smoke.bed").text == "chr01\t999\t1000\nchr01\t4999\t5000\nchr01\t8999\t9000\n"
            assert path("$outputDir/liftover/tomato-smoke.snpcalling.bed").text == "chr01\t899\t1100\nchr01\t4899\t5100\nchr01\t8899\t9100\n"
        }
    }

    test("reuses provided chain and skips alignment") {
        options "-stub"

        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                // Stub mode does not execute chain header validation; CI runs full reuse checks.
                chain = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            def taskNames = workflow.trace.tasks()*.name
            assert !taskNames.any { it.contains("ALIGN_AND_CHAIN:ALIGN_WHOLE_CHROMOSOME") }
            assert !taskNames.any { it.contains("ALIGN_AND_CHAIN:ALIGN_SPLIT_WINDOW") }
            assert !taskNames.any { it.contains("ALIGN_AND_CHAIN:PAF_TO_CHAIN") }
            assert !taskNames.any { it.contains("ALIGN_AND_CHAIN:COMBINE_ALL_PAFS") }
            assert taskNames.any { it.contains("WRITE_CHAIN_META") }
            assert path("$outputDir/chain/chain_meta.yml").exists()
            assert path("$outputDir/chain/all.chain").exists()
        }
    }

    test("derives chromosome pairs when mapping is omitted") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert path("$outputDir/chain/all.chain").exists()
            assert path("$outputDir/liftover/tomato-smoke.id").text == "chr01_1000\nchr01_5000\nchr01_9000\n"
            assert path("$outputDir/liftover/tomato-smoke.bed").text == "chr01\t999\t1000\nchr01\t4999\t5000\nchr01\t8999\t9000\n"
            assert path("$outputDir/liftover/tomato-smoke.snpcalling.bed").text == "chr01\t899\t1100\nchr01\t4899\t5100\nchr01\t8899\t9100\n"
        }
    }

    test("runs tomato fixture with whole alignment mode") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                align_mode = "whole"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert path("$outputDir/chain/all.chain").exists()
            assert path("$outputDir/liftover/tomato-smoke.id").text == "chr01_1000\nchr01_5000\nchr01_9000\n"
            assert path("$outputDir/liftover/tomato-smoke.bed").text == "chr01\t999\t1000\nchr01\t4999\t5000\nchr01\t8999\t9000\n"
            assert path("$outputDir/liftover/tomato-smoke.snpcalling.bed").text == "chr01\t899\t1100\nchr01\t4899\t5100\nchr01\t8899\t9100\n"
        }
    }

    test("runs tomato fixture with split alignment mode") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                align_mode = "split"
                split_size = 4000
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert path("$outputDir/chain/all.chain").exists()
            assert path("$outputDir/liftover/tomato-smoke.id").text == "chr01_1000\nchr01_5000\nchr01_9000\n"
            assert path("$outputDir/liftover/tomato-smoke.bed").text == "chr01\t999\t1000\nchr01\t4999\t5000\nchr01\t8999\t9000\n"
            assert path("$outputDir/liftover/tomato-smoke.snpcalling.bed").text == "chr01\t899\t1100\nchr01\t4899\t5100\nchr01\t8899\t9100\n"
        }
    }

    test("writes split-coordinate liftover bed outputs") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                split_bed = "$baseDir/tests/data/tomato-smoke/split.bed"
                split_genome_fai = "$baseDir/tests/data/tomato-smoke/split.genome.fa.fai"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert path("$outputDir/liftover/tomato-smoke.id").text == "chr01_1000\nchr01_5000\nchr01_9000\n"
            assert path("$outputDir/liftover/tomato-smoke.pos.tsv").text == "chr01\t1000\tSL4.0ch01_1000\nchr01\t5000\tSL4.0ch01_5000\nchr01\t9000\tSL4.0ch01_9000\n"
            assert path("$outputDir/liftover/tomato-smoke.bed").text == "chr01_part1\t999\t1000\nchr01_part2\t999\t1000\nchr01_part3\t999\t1000\n"
            assert path("$outputDir/liftover/tomato-smoke.snpcalling.bed").text == "chr01_part1\t899\t1100\nchr01_part2\t899\t1100\nchr01_part3\t899\t1100\n"
        }
    }

    test("runs tomato fixture in stub mode") {
        options "-stub"

        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                align_mode = "split"
                split_size = 4000
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            def taskNames = workflow.trace.tasks()*.name
            assert taskNames.any { it.contains("ALIGN_AND_CHAIN:EXTRACT_CHROM_FASTAS") }
            assert taskNames.any { it.contains("ALIGN_AND_CHAIN:BUILD_QUERY_MMI") }
            assert taskNames.any { it.contains("ALIGN_AND_CHAIN:SPLIT_REF_CHROMOSOME") }
            assert taskNames.any { it.contains("ALIGN_AND_CHAIN:ALIGN_SPLIT_WINDOW") }
            assert taskNames.any { it.contains("ALIGN_AND_CHAIN:COMBINE_SPLIT_PAFS") }
            assert path("$outputDir/chain/all.chain").exists()
            assert path("$outputDir/software_versions.yml").exists()
        }
    }

    test("rejects unsupported aligner") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                aligner = "bwa"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("Unsupported --aligner") }
            assert workflow.stdout.any { it.contains("supported: minimap2, mm2plus") }
        }
    }

    test("rejects aligner outside supported list even if mapped in aligner_envs") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                aligner = "bwa"
                aligner_envs = [bwa: "some-env"]
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("Unsupported --aligner") }
            assert workflow.stdout.any { it.contains("supported: minimap2, mm2plus") }
        }
    }

    test("rejects mm2plus when aligner_envs mapping is missing") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                aligner = "mm2plus"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("Missing aligner_envs") }
            assert workflow.stdout.any { it.contains("nextflow.config.example") }
        }
    }

    test("rejects mm2plus when aligner_envs mapping is empty") {
        when {
            params {
                id = "$baseDir/tests/data/tomato-smoke/tomato-smoke.id"
                ref_fa = "$baseDir/tests/data/tomato-smoke/SL4.0ch01.10kb.fa"
                query_fa = "$baseDir/tests/data/tomato-smoke/LA2093.chr01.10kb.fa"
                mapping = "$baseDir/tests/data/tomato-smoke/chrom_pairs.tsv"
                aligner = "mm2plus"
                aligner_envs = [minimap2: "nf-liftover-tools", mm2plus: ""]
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("Missing aligner_envs") }
            assert workflow.stdout.any { it.contains("nextflow.config.example") }
        }
    }
}
