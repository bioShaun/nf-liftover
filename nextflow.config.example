manifest {
    name            = 'nf-liftover'
    description     = 'End-to-end liftover and chain-generation pipeline'
    version         = '0.2.0'
    nextflowVersion = '>=26.0.0'
}

params {
    help            = false
    id              = null
    vcf             = null
    ref_fa          = null
    query_fa        = null
    ref_fai         = null
    query_fai       = null
    mapping         = null
    chain           = null
    chain_meta      = null
    outdir          = 'results'
    pair_strategy   = 'suffix'
    aligner         = 'minimap2'
    align_mode      = 'auto'
    split_threshold = 100_000_000
    split_size      = 10_000_000
    split_bed       = null
    split_genome_fai = null
    flank           = 100
    // Publish merged all.paf to outdir/chain (large genomes: leave false)
    publish_paf     = false
    // Default minimap2/mm2plus alignment args (asm-level)
    minimap2_args   = '-cx asm5 --cs'

    // Path to the base conda/mamba installation
    conda_dir = '/project/software/miniforge3'
    // Mapping of labels to environment directory names
    conda_envs = [
        ngs: 'nf-liftover-tools',
        py : 'nf-liftover-tools',
    ]
    // Environment directory name providing each supported aligner binary
    aligner_envs = [
        minimap2: 'nf-liftover-tools',
        mm2plus : 'mm2plus',
    ]

    max_cpus   = 16
    max_memory = '60.GB'
    max_time   = '48.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/conda.config'
includeConfig 'conf/modules.config'

conda {
    enabled  = true
    useMamba = true
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    slurm_new {
        includeConfig 'conf/slurm.config'
        process.queue    = 'cae'
    }

    test {
        process.executor = 'local'
        includeConfig 'conf/test.config'
    }

    // Clean CI runners without shared miniforge: Nextflow-managed conda packages
    ci {
        process.executor = 'local'
        includeConfig 'conf/ci.config'
    }
}

// Observability and reporting outputs (overwrite so -resume / reruns do not fail)
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
