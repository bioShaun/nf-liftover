{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/nf-liftover/nextflow_schema.json",
  "title": "nf-liftover parameters",
  "type": "object",
  "properties": {
    "help": {
      "type": ["boolean", "string"],
      "description": "Show parameter help and exit",
      "default": false
    },
    "id": {
      "type": "string",
      "description": "Input chrom_pos ID file"
    },
    "ref_fa": {
      "type": "string",
      "description": "Original/reference FASTA"
    },
    "query_fa": {
      "type": "string",
      "description": "Target/new FASTA"
    },
    "ref_fai": {
      "type": ["string", "null"],
      "description": "Optional FASTA index for ref_fa"
    },
    "query_fai": {
      "type": ["string", "null"],
      "description": "Optional FASTA index for query_fa"
    },
    "mapping": {
      "type": ["string", "null"],
      "description": "Optional two-column chromosome mapping TSV"
    },
    "outdir": {
      "type": "string",
      "default": "results"
    },
    "pair_strategy": {
      "type": "string",
      "enum": ["order", "suffix"],
      "default": "suffix"
    },
    "align_mode": {
      "type": "string",
      "enum": ["auto", "whole", "split"],
      "default": "auto",
      "description": "Alignment mode: auto chooses whole or split per chromosome, whole aligns complete chromosomes, split aligns sliding windows"
    },
    "split_threshold": {
      "type": "integer",
      "default": 100000000,
      "minimum": 1
    },
    "split_size": {
      "type": "integer",
      "default": 10000000,
      "minimum": 1
    },
    "split_bed": {
      "type": ["string", "null"],
      "description": "Optional split.bed used to output liftover BED files in split-genome coordinates"
    },
    "split_genome_fai": {
      "type": ["string", "null"],
      "description": "Optional split genome FASTA index used to sort split BED output"
    },
    "flank": {
      "type": "integer",
      "default": 100,
      "minimum": 0
    },
    "conda_dir": {
      "type": "string",
      "default": "/project/software/miniforge3"
    },
    "conda_envs": {
      "type": "object"
    },
    "max_cpus": {
      "type": "integer",
      "default": 16,
      "minimum": 1
    },
    "max_memory": {
      "type": "string",
      "default": "60.GB"
    },
    "max_time": {
      "type": "string",
      "default": "48.h"
    }
  },
  "required": ["id", "ref_fa", "query_fa"],
  "additionalProperties": true
}
