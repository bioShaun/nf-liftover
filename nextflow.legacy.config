manifest {
    name            = 'nf-liftover'
    description     = 'End-to-end liftover and chain-generation pipeline'
    version         = '0.1.0'
    nextflowVersion = '>=26.0.0'
}

plugins {
    id 'nf-schema@2.7.2'
}

params {
    help            = false
    id              = null
    vcf             = null
    ref_fa          = null
    query_fa        = null
    ref_fai         = null
    query_fai       = null
    mapping         = null
    chain           = null
    chain_meta      = null
    outdir          = 'results'
    pair_strategy   = 'suffix'
    // Intentionally omit aligner / aligner_envs so base.config fallbacks are exercised.
    align_mode      = 'auto'
    split_threshold = 100_000_000
    split_size      = 10_000_000
    split_bed       = null
    split_genome_fai = null
    flank           = 100
    publish_paf     = false
    minimap2_args   = '-cx asm5 --cs'

    // Path to the base conda/mamba installation
    conda_dir = '/project/software/miniforge3'
    // Mapping of labels to environment directory names
    conda_envs = [
        ngs: 'nf-liftover-tools',
        py : 'nf-liftover-tools',
    ]
}

// Workflow outputs are published under this directory (NF26 output block).
outputDir = "${params.outdir}"
// Preserve the legacy publishDir `mode: 'copy'` semantics for workflow outputs.
workflow {
    output {
        mode = 'copy'
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/conda.config'
includeConfig 'conf/modules.config'

conda {
    enabled  = true
    useMamba = true
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    slurm_new {
        includeConfig 'conf/slurm.config'
        process.queue    = 'cae'
    }

    test {
        process.executor = 'local'
        includeConfig 'conf/test.config'
    }
}

// Observability and reporting outputs
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled  = true
    overwrite = true
    file     = "${params.outdir}/pipeline_info/execution_trace.txt"
}
