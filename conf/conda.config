process {
    withLabel: 'tool_ngs' {
        conda        = "${params.conda_dir}/envs/${params.conda_envs.ngs}"
        beforeScript = "export PATH=${params.conda_dir}/condabin:${params.conda_dir}/bin:\$PATH; source ${params.conda_dir}/etc/profile.d/conda.sh"
    }

    // Alignment tasks need samtools/seqkit from the tools env plus the selected
    // aligner binary, which may live in a different env. Conda activates one env
    // only, so the aligner env bin is prepended to PATH by beforeScript.
    // Use .get() rather than [] — Nextflow ConfigMap auto-vivifies missing keys on
    // subscript, which would silently invent an empty aligner_envs entry and bypass
    // main.nf validation for legacy configs that lack aligner_envs.
    withLabel: 'tool_aligner' {
        conda        = "${params.conda_dir}/envs/${params.conda_envs.ngs}"
        beforeScript = "export PATH=${params.conda_dir}/envs/${params.aligner_envs?.get(params.aligner ?: 'minimap2') ?: params.conda_envs.ngs}/bin:${params.conda_dir}/condabin:${params.conda_dir}/bin:\$PATH; source ${params.conda_dir}/etc/profile.d/conda.sh"
    }

    withLabel: 'tool_py' {
        conda        = "${params.conda_dir}/envs/${params.conda_envs.py}"
        beforeScript = "export PATH=${params.conda_dir}/condabin:${params.conda_dir}/bin:\$PATH; source ${params.conda_dir}/etc/profile.d/conda.sh"
    }

    withLabel: 'tool_py_ngs' {
        conda        = "${params.conda_dir}/envs/${params.conda_envs.py}"
        beforeScript = "export PATH=${params.conda_dir}/condabin:${params.conda_dir}/bin:\$PATH; source ${params.conda_dir}/etc/profile.d/conda.sh"
    }
}
