process {
    withLabel: 'tool_ngs' {
        conda    = "${params.conda_dir}/envs/${params.conda_envs.ngs}"
        env.PATH = "${params.conda_dir}/envs/${params.conda_envs.ngs}/bin:" + System.getenv('PATH')
    }

    withLabel: 'tool_py' {
        conda    = "${params.conda_dir}/envs/${params.conda_envs.py}"
        env.PATH = "${params.conda_dir}/envs/${params.conda_envs.py}/bin:" + System.getenv('PATH')
    }
}
