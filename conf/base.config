params {
    max_cpus   = 16
    max_memory = '60.GB'
    max_time   = '48.h'
}

process {
    errorStrategy = 'terminate'

    withLabel: 'small_mem' {
        cpus   = 1
        memory = 8.GB
        time   = 24.h
    }

    withLabel: 'medium_mem' {
        cpus   = 4
        memory = 20.GB
        time   = 24.h
    }

    withLabel: 'large_mem' {
        cpus   = params.max_cpus
        memory = params.max_memory
        time   = params.max_time
    }
}
