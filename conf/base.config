params {
    max_cpus   = 16
    max_memory = '60.GB'
    max_time   = '48.h'
}

process {
    errorStrategy = { task.attempt < 3 ? 'retry' : 'terminate' }
    maxRetries = 2

    withLabel: 'small_mem' {
        cpus   = 1
        memory = 8.GB
        time   = 24.h
    }

    withLabel: 'medium_mem' {
        cpus   = 4
        memory = 20.GB
        time   = 24.h
    }

    withLabel: 'split_mem' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = 6.h
    }

    withLabel: 'large_mem' {
        cpus   = params.max_cpus
        memory = { 60.GB * task.attempt }
        time   = params.max_time
    }
}
