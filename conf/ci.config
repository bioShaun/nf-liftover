// CI / clean-checkout profile fragments.
// Use with: nextflow run . -c nextflow.config.example -profile ci
//
// Does not rely on a pre-existing /project/software/miniforge3 install.
// Process tools come from Nextflow-managed conda packages (same as test).

conda {
    enabled  = true
    useMamba = true
}

params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'
    // Ensure defaults exist even if only -c nextflow.config.example is partial
    pair_strategy = params.pair_strategy ?: 'suffix'
    align_mode    = params.align_mode ?: 'auto'
    publish_paf   = params.publish_paf ?: false
}

process {
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    withLabel: 'large_mem' {
        cpus   = params.max_cpus
        time   = params.max_time
    }

    withLabel: 'tool_ngs' {
        conda        = 'bioconda::samtools=1.23.1 bioconda::minimap2=2.31 bioconda::transanno=0.4.5 bioconda::htslib=1.23.1'
        beforeScript = null
    }

    withLabel: 'tool_py' {
        conda        = 'conda-forge::python=3.11.15 conda-forge::pandas=3.0.3 conda-forge::typer=0.26.8 conda-forge::loguru=0.7.3 bioconda::pyfaidx=0.9.0.4'
        beforeScript = null
    }

    withLabel: 'tool_py_ngs' {
        conda        = 'conda-forge::python=3.11.15 conda-forge::pandas=3.0.3 conda-forge::typer=0.26.8 conda-forge::loguru=0.7.3 bioconda::pyfaidx=0.9.0.4 bioconda::samtools=1.23.1 bioconda::minimap2=2.31 bioconda::transanno=0.4.5 bioconda::htslib=1.23.1'
        beforeScript = null
    }
}
